# Copy to private build environment. Do not invent the deployment domain.
BETA_API_BASE_URL=
BETA_FIELD_IDENTITY_BASE_URL=
# npm run build -- --mode beta; then cap sync android; then assembleBeta.
# Gradle reads these from process environment (not automatically from this file).
FIELD_RECOVERY_PREVIOUS_ORIGIN_SHA256=
VITE_HTTP_TIMEOUT_MS=15000
VITE_GPS_TIMEOUT_MS=45000
# Signing credentials are private process environment, never VITE_*.
