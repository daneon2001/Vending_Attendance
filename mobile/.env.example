# Use development only for local debugging. Pilot and production reject cleartext URLs at build time.
VITE_DEPLOYMENT_MODE=development
VITE_API_BASE_URL=https://vending-api.example.test
VITE_HTTP_TIMEOUT_MS=15000
# GPS acquisition only: integer milliseconds, 15000-90000. Never a cache age.
VITE_GPS_TIMEOUT_MS=45000
