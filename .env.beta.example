# Server beta template: fill private values during Phase 13.10.
# Never copy local credentials, .env.local or DEMO CA onto the server.
APP_NAME="MEDICAL LIFE ONE - Vending Attendance INTERNAL BETA"
APP_ENV=beta
APP_KEY=
APP_DEBUG=false
APP_URL=
BETA_APP_URL=
APP_TIMEZONE=UTC
OPERATIONS_TIMEZONE=America/Mexico_City
OPERATIONS_STORAGE_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
ASSET_URL=
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vending_attendance_beta
DB_USERNAME=REQUIRED_RUNTIME_USER
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=
CACHE_STORE=database
CACHE_PREFIX=vending_beta_
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Do not expose mail-based password recovery until private SMTP is configured.
MAIL_MAILER=log
VITE_APP_NAME="MEDICAL LIFE ONE"
VITE_APP_BASE_PATH=
BETA_ALLOWED_ORIGIN=https://localhost
BETA_TRUSTED_PROXIES=
INTERNAL_BETA_ENABLED=true
BETA_CLEANUP_ENABLED=false
FORTIA_MOCK_MIGRATIONS_ENABLED=false
BETA_TESTER_REGISTRY_PATH=
INTERNAL_BETA_TESTERS_ENABLED=true
# Registry path must be shared/private/beta-onboarding/testers.json (absolute, mode 0640).
SYBI_VENDING_SYNC_ENABLED=false
FORTIA_EMPLOYEES_ALLOW_WRITE=false
FORTIA_EMPLOYEES_HTTP_CONTRACT_APPROVED=false
EMPLOYEE_LEGACY_IMPORT_ENABLED=false
VENDING_PILOT_USERS_ALLOW_PRODUCTION=false
PILOT_SCHEDULER_SUPERVISED=false
PILOT_MOBILE_API_URL=
DEVICE_STATIC_TOKEN=
EMPLOYEE_LOOKUP_API_TOKEN=
# No FORTIA_* database credentials: external legacy migrations must be separated.
# No server secret belongs in a VITE_* variable.
